# Copy to .env and fill in only the platforms you want to reach.
# DRY_RUN=1 needs no credentials at all: every platform returns status "dry_run"
# and nothing is published.
DRY_RUN=1

# Platforms to publish to, in this order. Selection is internal to the app.
# Options: telegram, mastodon, bluesky, devto, discord, slack
ENABLED_PLATFORMS=telegram,mastodon,bluesky,devto,discord,slack
REQUEST_TIMEOUT=15

# Telegram — BotFather token + the chat/channel id the bot posts into
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mastodon — instance URL + access token with write:statuses
MASTODON_BASE_URL=https://mastodon.social
MASTODON_TOKEN=

# Bluesky — handle + an App Password (Settings > App Passwords), not your login password
BLUESKY_PDS=https://bsky.social
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Dev.to — Settings > Extensions > DEV Community API Keys
DEVTO_API_KEY=

# Discord — Server Settings > Integrations > Webhooks > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Slack — App > Incoming Webhooks > Webhook URL
SLACK_WEBHOOK_URL=
