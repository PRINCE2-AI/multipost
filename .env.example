# Defaults to a safe local mode: every delivery is written to var/mock_outbox.jsonl
# and nothing leaves the machine. Set DRY_RUN=0 to call the real APIs.
DRY_RUN=1

DB_PATH=var/multipost.db
OUTBOX_PATH=var/mock_outbox.jsonl
MAX_ATTEMPTS=5
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL=1.0

# Only needed when DRY_RUN=0.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MASTODON_BASE_URL=https://mastodon.social
MASTODON_TOKEN=
DEVTO_API_KEY=
